* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.pbs text eol=lf
*.cmd text eol=crlf
# Preserve exact bytes of hashed numerical archives and manifests.
# JSON/CSV parsers accept either line ending; executable sources remain LF.
*.json -text
*.csv -text
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.npz binary
*.png binary
*.gif binary
*.pdf binary
